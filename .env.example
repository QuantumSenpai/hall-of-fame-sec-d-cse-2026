# Server & Port Configuration
PORT=5000
NODE_ENV=development

# Neon PostgreSQL Database Connection (Required)
# Example: postgresql://username:password@ep-cool-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Auth Secret for Admin JWT Tokens (Required)
JWT_SECRET=

# Admin Authentication (Required: configure ADMIN_PASSWORD or ADMIN_PASSWORD_HASH)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Optional Bcrypt hash alternative (recommended for production):
# ADMIN_PASSWORD_HASH=$2a$12$...

# Vercel KV Configuration (Required for photo likes and pending memory moderation queue)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Google Drive Storage Integration (Optional - Direct public links supported out of the box)
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_API_KEY=

# YouTube Video Embed Configuration (Optional)
YOUTUBE_API_KEY=
