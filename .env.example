# Server & Port Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Neon PostgreSQL)
# Example: postgresql://username:password@ep-cool-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:sample_password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Auth Secret for Admin JWT Tokens
JWT_SECRET=teachers_day_2026_super_secret_jwt_key_change_in_production

# Admin Initial Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=teachersday2026

# Google Drive Storage Integration (Optional - Direct public links supported out of the box)
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_API_KEY=

# YouTube Video Embed Configuration
YOUTUBE_API_KEY=
