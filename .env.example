# Server & Port Configuration
PORT=5000
NODE_ENV=development

# Auth Secret for Admin JWT Tokens (Required)
JWT_SECRET=generate_a_random_64_char_string

# Admin Authentication (Required: configure ADMIN_PASSWORD or ADMIN_PASSWORD_HASH)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_strong_password
# Optional Bcrypt hash alternative (recommended for production):
# ADMIN_PASSWORD_HASH=$2a$12$...

# Google Drive Storage Integration (Optional - Direct public links supported out of the box)
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_API_KEY=

# YouTube Video Embed Configuration
YOUTUBE_API_KEY=

# GitHub Repository Integration (Vercel Serverless Content Commit Flow)
GITHUB_TOKEN=
GITHUB_OWNER=QuantumSenpai
GITHUB_REPO=hall-of-fame-sec-d-cse-2026
GITHUB_BRANCH=main
